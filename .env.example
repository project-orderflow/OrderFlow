APP_NAME=OrderFlow
ENVIRONMENT=development


POSTGRES_USER=orderflow
POSTGRES_PASSWORD=change_me
POSTGRES_DB=orderflow
DATABASE_URL=postgresql+asyncpg://orderflow:change_me@postgres:5432/orderflow
JWT_SECRET_KEY=change_this_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
WOOCOMMERCE_BASE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
WOOCOMMERCE_WEBHOOK_SECRET=
VITE_API_URL=/api

# Local demo WordPress/MySQL credentials (not used for a real store)
WC_DB_PASSWORD=change_me_local_only
WC_DB_ROOT_PASSWORD=change_me_root_local_only
# Generated by scripts/start.ps1 if empty. Used only to create a new WordPress administrator.
WC_ADMIN_PASSWORD=

# Local-only password used when explicitly running the demo seed command.
ORDERFLOW_DEMO_PASSWORD=OrderFlowDemo!2026
